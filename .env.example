# Where a copy of this file goes:
# - Installed app: the user settings file, named .env, in a termrenamer folder under
#   your per-user configuration folder:
#     Windows:        %APPDATA%\termrenamer\.env, or AppData\Roaming\termrenamer\.env
#                     in your home folder when APPDATA is unset or empty
#     macOS / Linux:  $XDG_CONFIG_HOME/termrenamer/.env, or ~/.config/termrenamer/.env
#                     when XDG_CONFIG_HOME is unset, empty or relative
#   The app reads it from whichever folder you start termrenamer in, and never writes it.
# - Clone: .env at the repository root, read when you start the app from that root.
# A .env in the folder you start the app from overrides the user settings file, and
# TERMRENAMER_* environment variables override both. Only that exact folder is checked.
# A blank value (NAME=) counts as not set, so it never hides a value from a lower source.
# Never commit .env or real keys. See README.md (Configure) for an overview.

# Provider keys. The app starts when at least one of these three keys is set; one is
# enough. A provider whose key is missing is marked "no key" on the screen, and building
# a plan with it reports the missing key.

# TMDB — a TV and Film provider; needed to build a plan with TMDB.
TERMRENAMER_TMDB_API_KEY=

# TheTVDB v4 — needed to build a TV plan with TheTVDB as the provider.
TERMRENAMER_TVDB_API_KEY=
# Optional; required for some subscriber accounts. A PIN alone is not a key.
# TERMRENAMER_TVDB_SUBSCRIBER_PIN=

# OMDb — a film provider; needed to build a Film plan with OMDb.
# TERMRENAMER_OMDB_API_KEY=

# HTTP request timeout in seconds (default applied in code if unset).
TERMRENAMER_HTTP_TIMEOUT_SECONDS=30

# Retry / backoff (defaults in code if unset).
TERMRENAMER_HTTP_MAX_ATTEMPTS=4
TERMRENAMER_HTTP_BACKOFF_BASE_SECONDS=0.5
TERMRENAMER_HTTP_JITTER=true

# Optional: separate output roots (scan still uses the working directory in the TUI).
# Film and TV are independent. Ignored when folder rename is disabled (filename-only renames).
# TERMRENAMER_FILM_DEST_FOLDER=/Volumes/media/films_output    # macOS/Linux example; Windows: K:\films_output
# TERMRENAMER_TV_DEST_FOLDER=/Volumes/media/tv_output          # macOS/Linux example; Windows: K:\tv_output

# Rename layout (defaults false): enable canonical show/film folder moves; second applies to TV when first is on.
# TERMRENAMER_ENABLE_FOLDER_RENAME=true
# TERMRENAMER_ENABLE_SEASON_FOLDERS=true

# Name taken: what a plan does with a file whose new name is already used, by a file,
# a folder or a link at that path, or by another file of the same plan.
# suffix (default) adds a number such as " (1)"; skip leaves the file where it is.
# A Sidecar is tested on its own: under skip, one whose name is taken stays while its
# video moves. Any other value stops the app at start-up. Nothing is ever overwritten.
# TERMRENAMER_NAME_TAKEN=skip

# Screen colours: dark (default) or light. Any other value stops the app at start-up.
# TERMRENAMER_THEME=light

# Posters (default true): show the selected Title's Poster beside the Title list. Needs the
# posters extra and a terminal that draws Sixel or Kitty images; `i` hides or shows it for
# the session. Takes true/false, 1/0, yes/no, on/off; any other value stops the app at start-up.
# TERMRENAMER_SHOW_POSTERS=false

# Optional: SQLite metadata cache (performance only; safe to delete).
# TERMRENAMER_CACHE_DB_PATH=/path/to/termrenamer-cache.db

# Reserved for future file logging (path read in settings; bootstrap uses stderr first).
# While the TUI is running, stdlib logging is routed to the Logs view (press l), not raw stderr.
# For capture outside the TUI or early bootstrap errors, see docs/runbook.md. Never commit secrets.
# TERMRENAMER_LOG_FILE=termrenamer.log
